VITE_API_BASE_URL=http://localhost:8000/api

# Public site origin used for canonical URLs, Open Graph tags and structured data.
VITE_SITE_URL=https://nyrix.tech

# Public contact details shown on /contact — leave unset to hide that field.
# Fill in only with real, working company contact info.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics
# entirely — every tracking call becomes a no-op when this is unset.
VITE_GA_MEASUREMENT_ID=

# The id gtag.js is loaded with. Optional — when unset, GA_MEASUREMENT_ID or
# GOOGLE_ADS_CONVERSION_ID is used to load the script instead (any one of the three works,
# since a single gtag.js instance serves every product you `config` against it).
VITE_GOOGLE_TAG_ID=

# Google Ads conversion tracking (e.g. AW-XXXXXXXXX / AbC-D_efG-h12-i345). Both must be set
# together for the Ads "conversion" event to fire — see trackAuditSubmitted in analytics.ts.
# Leave blank until a Google Ads account is actually connected.
VITE_GOOGLE_ADS_CONVERSION_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=
