VITE_API_BASE_URL=http://localhost:8000/api

# Public site origin used for canonical URLs, Open Graph tags and structured data.
VITE_SITE_URL=https://nyrix.tech

# Public contact details shown on /contact — leave unset to hide that field.
# Fill in only with real, working company contact info.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics
# entirely — every tracking call becomes a no-op when this is unset.
VITE_GA_MEASUREMENT_ID=
